# Environment-variable template for deployment tooling.
# Spring Boot does not load .env automatically; configure these variables in the
# shell, container, CI, or secret manager that starts the application.

DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_API_KEY=
# Optional: defaults to the embedding key when empty.
DASHSCOPE_RERANK_API_KEY=
DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_RERANK_MODEL=gte-rerank-v2
MYSQL_PASSWORD=
RAG_DB_PATH=jdbc:sqlite:rag_knowledge.sqlite
APP_DATA_GOVERNANCE_ENABLED=false
# Stage 3.4 rollback switches: keep both false until the canary run is approved.
CHAT_VECTORSTORE_RERANK_ENABLED=false
CHAT_VECTORSTORE_RERANK_CANARY_USERS=
CHAT_RAG_COMPRESSION_ENABLED=false
CHAT_RAG_COMPRESSION_CANARY_USERS=
SENIVERSE_API_KEY=
AMAP_API_KEY=
XUNFEI_TTS_APP_ID=
XUNFEI_TTS_API_KEY=
XUNFEI_TTS_API_SECRET=
BAIDU_SEARCH_API_KEY=
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SESSION_COOKIE_SECURE=false
