{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ai-eval-case.schema.json",
  "title": "ILink AI Evaluation Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "path",
    "category",
    "question",
    "expectedFacts",
    "forbiddenClaims",
    "expectedSourceIds",
    "expectedTools",
    "forbiddenTools",
    "allowedTools",
    "shouldRefuse",
    "multiTurn",
    "critical",
    "notes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "path": {
      "type": "string",
      "enum": [
        "stream",
        "tools"
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "expectedFacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenClaims": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedSourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedTools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbiddenTools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowedTools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "shouldRefuse": {
      "type": "boolean"
    },
    "multiTurn": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "critical": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  }
}
